{
  "expo": {
    "scheme": "fsm",
    "name": "fsm",
    "slug": "field-service-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apps.companion.fsm",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "platform.onemap8.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "NSLocationWhenInUseUsageDescription": "Field Service Manager uses your location to register check-ins and check-outs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Field Service Manager to use your location, also in the background, to report your position while you work.",
        "NSMotionUsageDescription": "Motion detection lets the app pause location updates while you are stationary and save battery.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDSjzgvcemQokfdzQq03rjryLfjHvQMVVk"
        }
      },
      "package": "com.apps.companion.fsm"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "./plugins/with-traccar",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you add them to your work orders.",
          "cameraPermission": "The app accesses your camera to let you add photos to your work orders."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Field Service Manager to use your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1401117-ac16-4a1f-94e7-6d5b17045142"
      }
    },
    "owner": "evallgar"
  }
}
